# Client-visible Supabase keys
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets (never exposed to client bundle)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DEVICE_HASH_PEPPER=replace-with-at-least-32-bytes-random-pepper-secret

# Rate limiting & bot protection
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
ARCJET_KEY=ajkey_your_key

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@upsapulse.org

# Error reporting (no PII or coordinates)
SENTRY_DSN=

# Restricted Unmask Feature Gate (D6: disabled until written policy approval)
ENABLE_UNMASK_WORKFLOW=false

